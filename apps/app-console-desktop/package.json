{
  "name": "tcg-cards-console-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main.js",
  "imports": {
    "#model/*": "@tcg-cards/model/*",
    "#task/*": "./electron/runtime/lib/task/*.ts"
  },
  "scripts": {
    "build": "nuxt build --prerender",
    "dev": "nuxt dev --no-fork --port 1420",
    "dev:web": "ELECTRON_STARTUP_PREVENT=1 nuxt dev --no-fork --port 1420",
    "export:search:local:hearthstone": "bun scripts/export-local-search-hearthstone.ts",
    "export:search:local:magic": "bun scripts/export-local-search-magic.ts",
    "lint": "eslint .",
    "make:electron": "bun run build && electron-forge make",
    "package:electron": "bun run build && electron-forge package",
    "postinstall": "nuxt prepare",
    "preview": "electron .",
    "test:auth": "node --experimental-strip-types --test electron/auth.test.ts electron/publish-admission.test.ts && node --test electron/auth.test.mjs",
    "test:electron": "node --test electron/smoke.test.mjs electron/settings.test.mjs electron/tasks.test.mjs electron/auth.test.mjs",
    "test:runtime": "bun test electron/runtime",
    "test:settings": "node --experimental-strip-types --test electron/settings.test.ts electron/legacy-settings.test.ts electron/legacy-sources.test.ts electron/development-trust.test.ts electron/publish-targets.test.ts electron/publish-credentials.test.ts",
    "test:tasks": "node --test electron/tasks.test.mjs && bun test electron/task/store.test.ts electron/task/recover.test.ts",
    "typecheck": "nuxt typecheck && bun run typecheck:electron && bun run typecheck:scripts",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "verify:search:cost": "bun scripts/verify-magic-cost-dictionary.ts",
    "verify:search:ordering": "bun scripts/verify-hearthstone-snapshot-ordering.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@iconify-json/lucide": "^1.2.104",
    "@iconify/vue": "^5.0.1",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/ui": "4.5.1",
    "@orpc/server": "^1.14.0",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@ai-sdk/vue": "4.0.31",
    "@tcg-cards/base": "workspace:*",
    "@tcg-cards/model": "workspace:*",
    "@tcg-cards/search": "workspace:*",
    "@tcg-cards/shared": "workspace:*",
    "@tcg-cards/console-core": "workspace:*",
    "@tcg-cards/console-api": "workspace:*",
    "@tcg-cards/console-platform": "workspace:*",
    "@tcg-cards/console-shell": "workspace:*",
    "@tcg-cards/db": "workspace:*",
    "@tcg-cards/ui": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/lodash-es": "^4.17.12",
    "@zip.js/zip.js": "^2.11.2",
    "bun-types": "^1.4.3",
    "electron": "^45.0.0",
    "eslint": "^10.2.1",
    "eslint-config-custom": "workspace:*",
    "electron-store": "^12.0.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.2",
    "canonicalize": "^3.0.0",
    "cheerio": "^1.2.0",
    "hono": "^4.10.5",
    "lodash-es": "^4.18.1",
    "ai": "7.0.31",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "^0.55.1",
    "nuxt": "4.3.1",
    "nuxt-electron": "^0.7.0",
    "@pinyin-pro/data": "^1.3.1",
    "pinyin-pro": "^3.28.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.2.2",
    "saxes": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.4",
    "vue": "^3.5.29",
    "vue-draggable-plus": "^0.6.1",
    "yaml": "^2.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.5",
    "zod": "^4.6.7"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
