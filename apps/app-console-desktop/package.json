{
  "name": "tcg-cards-console-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "nuxt dev --no-fork --port 1420",
    "build": "nuxt build --prerender",
    "preview": "electron .",
    "postinstall": "nuxt prepare",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "test:electron": "node --test electron/smoke.test.mjs",
    "package:electron": "bun run build && electron-forge package",
    "make:electron": "bun run build && electron-forge make",
    "typecheck": "nuxt typecheck && bun run typecheck:electron",
    "dev:web": "ELECTRON_STARTUP_PREVENT=1 nuxt dev --no-fork --port 1420"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@iconify-json/lucide": "^1.2.104",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/ui": "4.5.1",
    "@orpc/server": "^1.14.0",
    "@tcg-cards/base": "workspace:*",
    "@tcg-cards/console-core": "workspace:*",
    "@tcg-cards/console-platform": "workspace:*",
    "@tcg-cards/console-shell": "workspace:*",
    "@tcg-cards/ui": "workspace:*",
    "@types/node": "^25.6.0",
    "electron": "^45.0.0",
    "nuxt": "4.3.1",
    "nuxt-electron": "^0.7.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.4",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.5"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
