{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "electron"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "../shared/*.ts"
  ]
}
