{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#model/*": ["../../../packages/model/src/*"],
      "#task/*": ["./runtime/lib/task/*"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "electron",
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "../shared/*.ts"
  ]
}
