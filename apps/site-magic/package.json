{
  "name": "site-magic",
  "private": true,
  "type": "module",
  "imports": {
    "#search/*": "@tcg-cards/search/src/*",
    "#model/*": "@tcg-cards/model/*",
    "#schema/*": "@tcg-cards/db/schema/*",
    "#db/db": "@tcg-cards/db/db"
  },
  "scripts": {
    "build": "nuxt build --dotenv .env.production",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "benchmark:search:pg": "bun --env-file=../../scripts/.env scripts/pg-search-benchmark.ts",
    "benchmark:search:text-index": "bun --env-file=../../scripts/.env scripts/pg-text-index-benchmark.ts",
    "benchmark:search:acceleration-prototype": "bun --env-file=../../scripts/.env scripts/search-acceleration-prototype.ts",
    "search:local": "bun build --target=node --outfile node_modules/.cache/search-local-magic.mjs scripts/search-local.ts && node node_modules/.cache/search-local-magic.mjs",
    "benchmark:search:local": "bun build --target=node --outfile node_modules/.cache/search-local-benchmark-magic.mjs scripts/local-search-benchmark.ts && node node_modules/.cache/search-local-benchmark-magic.mjs",
    "benchmark:search:app-profile": "bun build --target=node --outfile node_modules/.cache/search-app-profile-magic.mjs scripts/app-search-profile.ts && node --env-file=../../scripts/.env --cpu-prof --cpu-prof-dir=../../.scratch/search-acceleration/benchmark-artifacts node_modules/.cache/search-app-profile-magic.mjs",
    "deploy": "wrangler deploy --env production"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@ai-sdk/vue": "^4.0.31",
    "@better-auth/api-key": "^1.5.5",
    "@better-auth/drizzle-adapter": "^1.5.5",
    "@iconify-json/lucide": "^1.2.104",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.72",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/ui": "4.5.1",
    "@orpc/client": "^1.14.0",
    "@orpc/server": "^1.14.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tcg-cards/auth": "workspace:*",
    "@tcg-cards/console-api": "workspace:*",
    "@tcg-cards/db": "workspace:*",
    "@tcg-cards/model": "workspace:*",
    "@tcg-cards/search": "workspace:*",
    "@tcg-cards/shared": "workspace:*",
    "@tcg-cards/ui": "workspace:*",
    "ai": "^7.0.31",
    "axios": "^1.13.6",
    "better-auth": "^1.5.5",
    "cheerio": "^1.2.0",
    "diff": "^8.0.3",
    "drizzle-orm": "^1.0.0-beta.22",
    "lodash-es": "^4.17.23",
    "markdown-it": "^14.1.1",
    "nanoid": "^5.1.6",
    "nuxt": "4.3.1",
    "postgres": "^3.4.8",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/bun": "^1.4.2",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "eslint": "^10.2.1",
    "eslint-config-custom": "workspace:*",
    "sass-embedded": "^1.97.3",
    "typescript": "^5.9.3",
    "unplugin-vue-router": "^0.19.2",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.85.0"
  }
}
