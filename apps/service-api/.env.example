# Origin this API service is served from (used by Better Auth for redirects/cookies).
BETTER_AUTH_BASE_URL=http://localhost:2997

# Public asset origin used to resolve published R2 keys in API responses.
ASSET_BASE_URL=https://asset.tcg.cards

# Secret used by Better Auth. Use a long random value in real environments.
BETTER_AUTH_SECRET=change-me

# Local Postgres connection string used by wrangler dev (via the HYPERDRIVE binding).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:5432/postgres
