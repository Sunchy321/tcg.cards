# Base URL of the API service (service-api) this docs site talks to.
# Local development points at the local service-api; production uses the public API.
API_BASE_URL=http://localhost:2997

# Public asset base URL (R2-backed static images).
ASSET_BASE_URL=https://asset.tcg.cards

# Secret used by Better Auth. Use a long random value in real environments.
BETTER_AUTH_SECRET=change-me

# Origin this docs site is served from (used by Better Auth for redirects/cookies).
BETTER_AUTH_URL=http://localhost:2996

# Node environment; nuxt picks up .env.production when set to production.
NODE_ENV=development
