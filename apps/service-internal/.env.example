# Secret used by Better Auth. Use a long random value in real environments.
BETTER_AUTH_SECRET=change-me

# Privileged database connection used only to issue short-lived publish credentials.
# It needs CREATEROLE and ADMIN OPTION on the publish writer role. Issued
# credentials point at this same database with the login replaced, so it is also
# the only place the publish database address is configured.
PUBLISH_ADMIN_CONNECTION_STRING=postgresql://postgres:change-me@localhost:5432/postgres

# Role granted to every publish account. Defaults to publish_writer when unset.
PUBLISH_WRITER_ROLE=publish_writer

# R2 S3 credentials used only to sign short-lived search upload URLs.
# They never reach a client; the desktop receives one signed URL per object.
R2_S3_ACCOUNT_ID=change-me
R2_S3_ACCESS_KEY_ID=change-me
R2_S3_SECRET_ACCESS_KEY=change-me
